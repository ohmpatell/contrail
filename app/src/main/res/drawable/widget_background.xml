<?xml version="1.0" encoding="utf-8"?>
<!-- Night-cockpit glass for home-screen widgets: deep navy with a faint aurora edge. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <corners android:radius="24dp" />
    <gradient
        android:angle="315"
        android:startColor="#F0101A33"
        android:centerColor="#F00A1122"
        android:endColor="#F0181238"
        android:type="linear" />
    <stroke android:width="1dp" android:color="#33FFFFFF" />
</shape>
